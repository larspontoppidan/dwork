# OpenCode web UI (https://opencode.ai).
DWORK_KIND=web
DWORK_DESCRIPTION="OpenCode web UI"
DWORK_HTTP_PORT=4096
DWORK_APP_CMD="opencode web --hostname 0.0.0.0 --port 4096"

# OpenCode's own HTTP basic auth is fed the same credentials as the proxy, so a
# single login works end to end (nginx forwards the Authorization header).
DWORK_AUTH_USER_ENV=OPENCODE_SERVER_USERNAME
DWORK_AUTH_PASS_ENV=OPENCODE_SERVER_PASSWORD
