# OpenCode 2 web UI (https://opencode.ai).
DWORK_KIND=web
DWORK_DESCRIPTION="OpenCode 2 web UI"
DWORK_HTTP_PORT=4096
DWORK_APP_CMD="opencode serve --hostname 0.0.0.0 --port 4096"

# Enable OpenCode's native HTTP basic authentication.
DWORK_AUTH_USER_ENV=OPENCODE_SERVER_USERNAME
DWORK_AUTH_PASS_ENV=OPENCODE_SERVER_PASSWORD
