# ZCode, the Z.ai desktop app (Electron), on a virtual X11 desktop via noVNC.
DWORK_KIND=x11
DWORK_DESCRIPTION="ZCode (Z.ai desktop app) on a VNC desktop"
# --no-sandbox: Chromium's sandbox needs privileges the container does not have.
# --disable-gpu: software rendering into the virtual framebuffer.
DWORK_APP_CMD="zcode --no-sandbox --disable-gpu --disable-dev-shm-usage"
