# Official ChatGPT desktop app (includes ChatGPT, Work, and Codex).
# https://learn.chatgpt.com/docs/linux/linux-app
DWORK_KIND=x11
DWORK_DESCRIPTION="ChatGPT desktop app (with Codex) on a VNC desktop"
# --no-sandbox: Chromium's sandbox needs privileges the container does not have.
# --disable-gpu: software rendering into the virtual framebuffer.
DWORK_APP_CMD="chatgpt --no-sandbox --disable-gpu --disable-dev-shm-usage"
